<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:JeekMusic.UI">
    <Styles.Resources>
      <ResourceDictionary>
        <!-- Playback identity deliberately has its own warm palette, independent of
             the system accent used by selection, navigation and other controls. -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="CurrentTrackBackgroundBrush" Color="#FFF1D6" />
                <SolidColorBrush x:Key="CurrentTrackHoveredBackgroundBrush" Color="#FFE6B5" />
                <SolidColorBrush x:Key="CurrentTrackBorderBrush" Color="#A5650D" />
                <SolidColorBrush x:Key="CurrentTrackMarkerBrush" Color="#805000" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="CurrentTrackBackgroundBrush" Color="#3F321E" />
                <SolidColorBrush x:Key="CurrentTrackHoveredBackgroundBrush" Color="#514027" />
                <SolidColorBrush x:Key="CurrentTrackBorderBrush" Color="#DBA650" />
                <SolidColorBrush x:Key="CurrentTrackMarkerBrush" Color="#95600D" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <SolidColorBrush x:Key="ArtistAccentBrush" Color="{DynamicResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ArtistAccentSubtleBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
      </ResourceDictionary>
    </Styles.Resources>

    <!-- Icon-only mode keeps its existing accessible name hint. Expanded names use
         the in-place, clipped-text reveal instead of a conventional tooltip. -->
    <Style Selector="TreeView TextBlock.nav-icon">
        <Setter Property="ToolTip.IsEnabled" Value="False" />
    </Style>
    <Style Selector="TreeView.collapsed TextBlock.nav-icon">
        <Setter Property="ToolTip.IsEnabled" Value="True" />
    </Style>

    <!-- A narrow visible rule, with a full-height six-DIP pointer target. -->
    <Style Selector="GridSplitter.pane-splitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Border Width="1" HorizontalAlignment="Center" Margin="0,8"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.pane-splitter:pointerover, GridSplitter.pane-splitter:pressed">
        <Setter Property="Background" Value="{DynamicResource ArtistAccentSubtleBrush}" />
    </Style>
    <Style Selector="GridSplitter.pane-splitter:focus-visible">
        <Setter Property="Background" Value="{DynamicResource ArtistAccentSubtleBrush}" />
    </Style>

    <Style Selector="ListBox.artist-list > ListBoxItem">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.artist-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ArtistAccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.artist-selection">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.artist-list > ListBoxItem:selected Border.artist-selection">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.artist-name">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ListBox.artist-list > ListBoxItem:selected TextBlock.artist-name">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.artist-index">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.artist-index:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ArtistAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.artist-index.current">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ArtistAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ArtistAccentSubtleBrush}" />
    </Style>

    <!-- 列表模板从所属控件读取此附加属性；统一让滚动区域为完整宽度的滚动条留出空间。 -->
    <Style Selector=":is(Control)">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <!-- 图标按钮：Segoe Fluent Icons / Segoe MDL2 Assets 的字形（UI/Icons.cs） -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon.large">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <!-- 打开的开关按钮：主题色实心圆底、反色图标（同移动端 U-11：只改颜色看不出来） -->
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 歌曲表格：表头、行背景透明，让窗口的 Mica 透出来（tech-spike.md：默认表头是不透明的） -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0,4,0" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Paint the existing full-row layer, not the title cell. Selection retains its
         theme fill/opacity; the current-track outline also survives horizontal scroll. -->
    <Style Selector="DataGrid#Table DataGridRow.current /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CurrentTrackBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid#Table DataGridRow.current:not(:selected) /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource CurrentTrackBackgroundBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid#Table DataGridRow.current:not(:selected):pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource CurrentTrackHoveredBackgroundBrush}" />
    </Style>
    <Style Selector="DataGrid#Table DataGridRow.current:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="StrokeThickness" Value="3" />
    </Style>
    <Style Selector="ui|CurrentTrackMarker">
        <Setter Property="Background" Value="{DynamicResource CurrentTrackMarkerBrush}" />
    </Style>
    <Style Selector="TextBlock.song-title.current">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGridRow.missing">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 导航栏：折叠成只有图标的窄条（需求 W-2） -->
    <Style Selector="TreeView.collapsed TextBlock.navtitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TreeViewItem.droptarget">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark2}" />
    </Style>
    <!-- 导航栏 -->
    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="34" />
    </Style>
</Styles>
