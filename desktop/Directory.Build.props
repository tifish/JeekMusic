<Project>
  <!-- These must be set before the SDK imports Microsoft.Common.props / NuGet assets.
       Keep build/publish, RID and explicit deployment switches out of each other's
       obj (including project.assets.json) and bin. RID-agnostic library references
       retain SDK defaults: the SDK removes RID/SelfContained when building them. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'JeekMusic.App'">
    <PublishAot Condition="'$(MSBuildProjectName)' == 'JeekMusic.App' and '$(PublishAot)' == ''">true</PublishAot>
    <_JeekOperation>build</_JeekOperation>
    <_JeekOperation Condition="'$(_IsPublishing)' == 'true'">publish</_JeekOperation>
    <_JeekRid>portable</_JeekRid>
    <_JeekRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_JeekRid>
    <_JeekDeployment>aot-$(PublishAot)_sc-$(SelfContained)_psc-$(PublishSelfContained)</_JeekDeployment>
    <BaseIntermediateOutputPath>obj\$(_JeekOperation)\$(_JeekRid)\$(_JeekDeployment)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(_JeekOperation)\$(_JeekRid)\$(_JeekDeployment)\</BaseOutputPath>
    <!-- Changing Base* must not let old obj/bin trees become default source items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- 正式工程（src/、tests/）的公共设置；spike/、spike-audio/ 不受影响（它们有自己的设置） -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\')) Or $(MSBuildProjectDirectory.Contains('\tests\'))">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
