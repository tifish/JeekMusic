<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 图标按钮：Segoe Fluent Icons / Segoe MDL2 Assets 的字形（UI/Icons.cs） -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon.large">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <!-- 打开的开关按钮：主题色实心圆底、反色图标（同移动端 U-11：只改颜色看不出来） -->
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 歌曲表格：表头、行背景透明，让窗口的 Mica 透出来（tech-spike.md：默认表头是不透明的） -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0,4,0" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- 正在播放的歌：整行加底色、标题加粗（需求 G-5、U-11） -->
    <Style Selector="DataGridRow.playing">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="DataGridRow.missing">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 导航栏：折叠成只有图标的窄条（需求 W-2） -->
    <Style Selector="TreeView.collapsed TextBlock.navtitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TreeViewItem.droptarget">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark2}" />
    </Style>
    <!-- 导航栏 -->
    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="34" />
    </Style>
</Styles>
