{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JeekMusic P0 group-sync primitives revision 1",
  "description": "Structural schema only. Runtime validation additionally requires integer JSON tokens, valid Unicode, UTF-16 limits and normalized relative paths. Not a deployed format 3 envelope or capability.",
  "oneOf": [
    { "$ref": "#/$defs/version" },
    { "$ref": "#/$defs/reference" },
    { "$ref": "#/$defs/mutation" }
  ],
  "$defs": {
    "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalMs", "logicalCounter", "originDeviceId", "deviceIncarnation", "originSequence"],
      "properties": {
        "physicalMs": { "$ref": "#/$defs/integer" },
        "logicalCounter": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "originDeviceId": { "$ref": "#/$defs/identity" },
        "deviceIncarnation": { "$ref": "#/$defs/identity" },
        "originSequence": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectionId", "path"],
      "properties": {
        "collectionId": { "$ref": "#/$defs/identity" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "cueTrackNo": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "generation", "key", "version", "payload"],
      "properties": {
        "groupId": { "$ref": "#/$defs/identity" },
        "generation": { "$ref": "#/$defs/positiveInteger" },
        "key": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "version": { "$ref": "#/$defs/version" },
        "payload": { "type": ["string", "null"], "maxLength": 1048576 }
      }
    }
  }
}
