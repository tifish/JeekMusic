<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JeekMusic.UI.ViewModels"
        xmlns:lib="using:JeekMusic.Library"
        xmlns:ui="using:JeekMusic.UI"
        x:Class="JeekMusic.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Jeek Music" Width="1200" Height="760" MinWidth="760" MinHeight="480"
        Icon="avares://JeekMusic/Assets/JeekMusic.ico"
        TransparencyLevelHint="Mica" Background="Transparent"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="46">
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Border#PART_WindowBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid#TitleBar Button">
            <Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
        </Style>
        <Style Selector="Grid#TitleBar TextBox">
            <Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 工具栏：后退 / 前进、搜索、筛选 -->
        <!-- 标题栏（需求 W-7）：工具栏放在标题栏里，空白处可以拖动窗口；右边留出系统的最小化 / 最大化 / 关闭按钮 -->
        <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto,150" Margin="8,4,0,2" Background="Transparent" MinHeight="40" WindowDecorationProperties.ElementRole="TitleBar">
            <!-- 最后一列专门留给系统窗口按钮，中间的搜索区域可收缩。 -->
            <StackPanel Orientation="Horizontal">
            <Image Source="avares://JeekMusic/Assets/JeekMusic.png" Width="18" Height="18" Margin="4,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Button Classes="icon" Content="{x:Static ui:Icons.Back}" Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding CanGoBack}" AutomationProperties.Name="{ui:Tr &apos;后退（Alt+←）&apos;}" ToolTip.Tip="{ui:Tr &apos;后退（Alt+←）&apos;}" />
            <Button Classes="icon" Content="{x:Static ui:Icons.Forward}" Command="{Binding GoForwardCommand}"
                    IsEnabled="{Binding CanGoForward}" AutomationProperties.Name="{ui:Tr &apos;前进（Alt+→）&apos;}" ToolTip.Tip="{ui:Tr &apos;前进（Alt+→）&apos;}" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" MinWidth="0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Margin="12,0" MaxWidth="460" MinWidth="0" HorizontalAlignment="Stretch"
                         PlaceholderText="{ui:Tr &apos;搜索歌名、艺术家、专辑、文件名，或拼音首字母（Ctrl+F）&apos;}" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ScanText}" Classes="secondary" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
            </Grid>
            <Button Grid.Column="2" x:Name="FilterButton" Classes="icon" AutomationProperties.Name="{ui:Tr &apos;按智能标签筛选&apos;}" ToolTip.Tip="{ui:Tr &apos;按智能标签筛选&apos;}" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="glyph" Text="{x:Static ui:Icons.Filter}" />
                    <TextBlock Text="{Binding FilterText}" FontFamily="{x:Static FontFamily.Default}" FontSize="13" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 主区：导航栏 | 艺术家栏 | 内容 | 歌词面板 -->
        <Grid Grid.Row="1" x:Name="MainArea" ColumnDefinitions="230,Auto,Auto,*,Auto,Auto">
            <DockPanel Grid.Column="0" x:Name="NavPanel">
            <Button DockPanel.Dock="Top" x:Name="NavCollapse" Classes="icon" Content="{x:Static ui:Icons.NavPane}" HorizontalAlignment="Left" Margin="8,0,0,2"
                    AutomationProperties.Name="{ui:Tr &apos;折叠 / 展开导航栏&apos;}" ToolTip.Tip="{ui:Tr &apos;折叠 / 展开导航栏&apos;}" />
            <Button DockPanel.Dock="Bottom" x:Name="SettingsButton" Classes="icon" Content="{x:Static ui:Icons.Settings}" HorizontalAlignment="Left" Margin="8,4,0,8"
                    AutomationProperties.Name="{ui:Tr &apos;设置&apos;}" ToolTip.Tip="{ui:Tr &apos;设置&apos;}" />
            <TreeView x:Name="NavTree" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Margin="4,0,0,0">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:NavNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:NavNode" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                            <TextBlock Classes="glyph" Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0" ToolTip.Tip="{Binding Title}" />
                            <TextBlock Grid.Column="1" Classes="navtitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="secondary navtitle" Text="{Binding CountText}" FontSize="11" Margin="8,0,4,0" VerticalAlignment="Center" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" x:Name="NavSplitter" Width="4" Background="Transparent" ResizeDirection="Columns" />

            <!-- 艺术家栏：只在选中"艺术家"时出现（需求 W-4） -->
            <Border Grid.Column="2" Width="230" IsVisible="{Binding ShowArtistPane}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,28">
                <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="14,14,12,12">
                    <TextBlock Text="{ui:Tr &apos;艺术家&apos;}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Artists.Count}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="14,0,12,6" Padding="0,3,0,5"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{ui:Tr &apos;当前字母&apos;}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="CurrentArtistLetter" Text="{Binding #ArtistList.CurrentLetter}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ArtistAccentBrush}"
                                   AutomationProperties.Name="{ui:Tr &apos;当前字母&apos;}" />
                    </Grid>
                </Border>
                <ui:ArtistListBox Grid.Row="2" x:Name="ArtistList" Classes="artist-list" ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="6,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="lib:ArtistInfo">
                            <StackPanel>
                                <Border Classes="artist-group-header" IsHitTestVisible="False"
                                        IsVisible="{Binding $parent[ListBoxItem].(ui:ArtistListBox.HasGroupHeader)}"
                                        Height="32" Padding="2,6,0,4" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <TextBlock Text="{Binding $parent[ListBoxItem].(ui:ArtistListBox.GroupHeader)}"
                                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ArtistAccentBrush}" />
                                </Border>
                                <Grid ToolTip.Tip="{Binding DisplayName}" MinHeight="62">
                                    <Border Classes="artist-selection" Width="3" Height="26" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                            Background="{DynamicResource ArtistAccentBrush}" />
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" Background="{DynamicResource ArtistAccentSubtleBrush}">
                                            <Panel>
                                                <TextBlock Text="{Binding AvatarText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ArtistAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="ArtistAvatarImage" Stretch="UniformToFill" Loaded="OnArtistAvatarLoaded" Unloaded="OnArtistAvatarUnloaded"
                                                       DataContextChanged="OnArtistAvatarDataContextChanged" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Classes="artist-name" FontSize="13" TextTrimming="CharacterEllipsis" x:Name="ArtistName" />
                                            <TextBlock Text="{Binding TrackCountText}" Classes="secondary" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ui:ArtistListBox>
                <!-- 字母索引（同移动端 A-1） -->
                <Viewbox Grid.Row="2" Grid.Column="1" Margin="4,4,4,8" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                <ItemsControl x:Name="LetterIndex" ItemsSource="{Binding #ArtistList.Groups}" AutomationProperties.Name="{ui:Tr &apos;艺术家字母索引&apos;}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:ArtistLetter">
                            <TextBlock Text="{Binding Letter}" Classes.current="{Binding IsCurrent}" FontSize="10" Classes="artist-index" Padding="4,2" HorizontalAlignment="Center" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Viewbox>
            </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="3" Margin="8,0,8,0">
                <!-- 首次启动：引导添加音乐文件夹（同移动端 L-4） -->
                <StackPanel IsVisible="{Binding IsWelcome}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <Image Source="avares://JeekMusic/Assets/JeekMusic.png" Width="96" Height="96" />
                    <TextBlock Text="{ui:Tr &apos;欢迎使用 Jeek Music&apos;}" Classes="title" HorizontalAlignment="Center" />
                    <TextBlock Text="{ui:Tr &apos;添加存放音乐的文件夹，曲库就围绕这些文件夹组织。&apos;}" Classes="secondary" HorizontalAlignment="Center" />
                    <Button x:Name="WelcomeAddFolder" Content="{ui:Tr &apos;添加音乐文件夹&apos;}" HorizontalAlignment="Center" Classes="accent" Padding="20,8" />
                </StackPanel>

                <TextBlock IsVisible="{Binding IsHint}" Text="{Binding HintText}" Classes="secondary" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" TextAlignment="Center" />

                <Grid IsVisible="{Binding IsSongs}" RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="88" Height="88" Margin="0,0,12,0" IsVisible="{Binding IsAlbumView}" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <Image Source="{Binding AlbumCover}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ContentTitle}" Classes="title" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AlbumInfo}" Classes="secondary" IsVisible="{Binding IsAlbumView}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ContentSubtitle}" Classes="secondary" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                            <CheckBox Content="{ui:Tr &apos;包含子文件夹&apos;}" IsChecked="{Binding IncludeSubfolders}" IsVisible="{Binding IsFolderView}" />
                            <Button x:Name="ArtistPinButton" Classes="icon" Content="{Binding ArtistPinIcon}" IsVisible="{Binding CanPinArtist}"
                                    AutomationProperties.Name="{Binding ArtistPinText}" ToolTip.Tip="{Binding ArtistPinText}" />
                            <Button x:Name="LocateButton" Classes="icon" Content="{x:Static ui:Icons.Locate}" AutomationProperties.Name="{ui:Tr &apos;定位到正在播放（Ctrl+L）&apos;}" ToolTip.Tip="{ui:Tr &apos;定位到正在播放（Ctrl+L）&apos;}" />
                            <Button x:Name="ListMoreButton" Classes="icon" Content="{x:Static ui:Icons.More}" AutomationProperties.Name="{ui:Tr &apos;更多&apos;}" ToolTip.Tip="{ui:Tr &apos;更多&apos;}" />
                        </StackPanel>
                    </Grid>
                    <!-- 搜索结果里的艺术家 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SearchArtists}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="lib:ArtistInfo">
                                <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="12,4" CornerRadius="12" Tag="{Binding NameKey}" Click="OnSearchArtistClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid Grid.Row="2" x:Name="Table" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Extended"
                              CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Tr &apos;标题&apos;}" SortMemberPath="Title" Width="3*" Tag="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SongRow">
                                        <Grid ColumnDefinitions="Auto,*" Margin="4,2">
                                            <Border Width="32" Height="32" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                <Panel>
                                                    <TextBlock Classes="glyph" Text="{x:Static ui:Icons.Music}" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;艺术家&apos;}" Binding="{Binding Artist}" Width="2*" Tag="Artist" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;专辑&apos;}" Binding="{Binding Album}" Width="2*" Tag="Album" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;时长&apos;}" Binding="{Binding Duration}" Width="92" Tag="Duration" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;文件名&apos;}" Binding="{Binding FileName}" Width="2*" Tag="FileName" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;修改时间&apos;}" Binding="{Binding Modified}" Width="154" Tag="Modified" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;格式&apos;}" Binding="{Binding Format}" Width="96" Tag="Format" />
                            <DataGridTextColumn x:DataType="vm:SongRow" Header="{ui:Tr &apos;智能标签&apos;}" Binding="{Binding TagText}" Width="140" Tag="Tags" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="4" x:Name="LyricsSplitter" Width="4" Background="Transparent" ResizeDirection="Columns" IsVisible="False" />
            <ContentControl Grid.Column="5" x:Name="LyricsHost" IsVisible="False" Width="360" />
        </Grid>

        <!-- 播放栏（需求 W-5） -->
        <Border Grid.Row="2" x:Name="PlayerBar" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="280,*,350" DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">
                <!-- 封面、标题、艺术家 -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="52" Height="52" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <Panel>
                            <TextBlock Classes="glyph" Text="{x:Static ui:Icons.Music}" FontSize="22" HorizontalAlignment="Center" Opacity="0.5" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NowTitle" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Cursor="Hand" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NowArtist" Content="{Binding Artist}" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" FontSize="12" MaxWidth="140" AutomationProperties.Name="{ui:Tr &apos;查看艺术家&apos;}" ToolTip.Tip="{ui:Tr &apos;查看艺术家&apos;}" />
                            <Button x:Name="NowAlbum" Content="{Binding Album}" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" FontSize="12" MaxWidth="140" AutomationProperties.Name="{ui:Tr &apos;查看专辑&apos;}" ToolTip.Tip="{ui:Tr &apos;查看专辑&apos;}" />
                        </StackPanel>
                        <Button x:Name="OutputModeButton" Padding="0" MinHeight="0"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" AutomationProperties.Name="{Binding OutputModeTip}" ToolTip.Tip="{Binding OutputModeTip}">
                            <TextBlock Text="{Binding FormatText}" Classes="secondary" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- 播放控制和进度 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <ToggleButton Classes="icon" Content="{x:Static ui:Icons.Shuffle}" IsChecked="{Binding Shuffle, Mode=OneWay}" Command="{Binding ToggleShuffleCommand}" AutomationProperties.Name="{ui:Tr &apos;随机播放&apos;}" ToolTip.Tip="{ui:Tr &apos;随机播放&apos;}" />
                        <Button Classes="icon" Content="{x:Static ui:Icons.Previous}" Command="{Binding PreviousCommand}" AutomationProperties.Name="{ui:Tr &apos;上一首（Z）&apos;}" ToolTip.Tip="{ui:Tr &apos;上一首（Z）&apos;}" />
                        <Button Classes="icon large" Content="{Binding PlayIcon}" Command="{Binding PlayPauseCommand}" AutomationProperties.Name="{Binding PlayTip}" ToolTip.Tip="{Binding PlayTip}" />
                        <Button Classes="icon" Content="{x:Static ui:Icons.Next}" Command="{Binding NextCommand}" AutomationProperties.Name="{ui:Tr &apos;下一首（X）&apos;}" ToolTip.Tip="{ui:Tr &apos;下一首（X）&apos;}" />
                        <ToggleButton Classes="icon" Content="{Binding RepeatIcon}" IsChecked="{Binding RepeatOn, Mode=OneWay}" Command="{Binding CycleRepeatCommand}" AutomationProperties.Name="{Binding RepeatTip}" ToolTip.Tip="{Binding RepeatTip}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding PositionText}" Classes="secondary" FontSize="11" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                        <Slider Grid.Column="1" x:Name="Progress" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                Margin="8,-8" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="secondary" FontSize="11" VerticalAlignment="Center" MinWidth="40" />
                    </Grid>
                </StackPanel>
                <!-- 睡眠定时、音量、队列、歌词、迷你播放器 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <Button x:Name="OutputButton" Classes="icon" Content="{x:Static ui:Icons.Speaker}" AutomationProperties.Name="{ui:Tr &apos;输出设备&apos;}" ToolTip.Tip="{ui:Tr &apos;输出设备&apos;}" />
                    <Button x:Name="SleepButton" Classes="icon" AutomationProperties.Name="{ui:Tr &apos;睡眠定时&apos;}" ToolTip.Tip="{ui:Tr &apos;睡眠定时&apos;}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="glyph" Text="{x:Static ui:Icons.Moon}" />
                            <TextBlock Text="{Binding SleepText}" FontFamily="{x:Static FontFamily.Default}" FontSize="12" IsVisible="{Binding SleepActive}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Content="{Binding VolumeIcon}" Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="{ui:Tr &apos;静音&apos;}" ToolTip.Tip="{ui:Tr &apos;仅静音本播放器&apos;}" />
                    <StackPanel Width="90" VerticalAlignment="Center">
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="{Binding Volume}" IsEnabled="{Binding VolumeAvailable}"
                                AutomationProperties.Name="{ui:Tr &apos;当前输出设备主音量&apos;}" ToolTip.Tip="{Binding VolumeTip}" />
                        <TextBlock Text="{Binding VolumeState}" MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="10" ToolTip.Tip="{Binding VolumeState}" />
                    </StackPanel>
                    <Button x:Name="QueueButton" Classes="icon" Content="{x:Static ui:Icons.Queue}" AutomationProperties.Name="{ui:Tr &apos;播放队列&apos;}" ToolTip.Tip="{ui:Tr &apos;播放队列&apos;}" />
                    <ToggleButton x:Name="LyricsToggle" Classes="icon" Content="{x:Static ui:Icons.Lyrics}" AutomationProperties.Name="{ui:Tr &apos;歌词&apos;}" ToolTip.Tip="{ui:Tr &apos;歌词&apos;}" />
                    <Button x:Name="MiniButton" Classes="icon" Content="{x:Static ui:Icons.MiniPlayer}" AutomationProperties.Name="{ui:Tr &apos;迷你播放器&apos;}" ToolTip.Tip="{ui:Tr &apos;迷你播放器&apos;}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 提示 -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="16,8" CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" MaxWidth="560" />
        </Border>
    </Grid>
</Window>
