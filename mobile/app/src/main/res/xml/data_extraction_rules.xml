<?xml version="1.0" encoding="utf-8"?>
<!--
    云备份：全部排除。用户数据通过音乐目录里的 .jeekmusic/sync/ 按设备备份（需求 §3.16）。
    换机迁移（设备间直传）：保留默认行为，全部迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="lan-sync.json" />
        <exclude domain="file" path="lan-owned.json" />
        <exclude domain="file" path="lan-partials/" />
    </device-transfer>
</data-extraction-rules>
