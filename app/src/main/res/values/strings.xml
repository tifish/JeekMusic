    <string name="lyrics_save_hidden">Hidden folder</string>
    <string name="lyrics_save_hidden_summary">.jeekmusic/lyrics/ in the music folder. Music files are not changed</string>
    <string name="lyrics_save_embed">Inside the music file</string>
    <string name="lyrics_save_embed_summary">The file’s modified time is kept. Needs “All files access”. CUE tracks are saved to the hidden folder instead. Lyrics already downloaded are written in too, and the downloaded .lrc files deleted</string>
    <string name="lyrics_saved_hidden">Lyrics saved to the hidden folder</string>
    <string name="lyrics_saved_embed">Lyrics saved into the music file</string>
    <string name="all_files_title">Allow access to all files?</string>
    <string name="all_files_message">To keep the file’s modified time unchanged when writing into music files, JeekMusic needs “All files access”. Android doesn’t let apps change the modified time of other apps’ files without it. It is only used to restore the modified time after writing covers and lyrics.\n\nWithout it, music files are not changed and covers and lyrics are saved to the hidden folder instead.</string>
    <string name="all_files_grant">Allow</string>
    <string name="all_files_missing">“All files access” not allowed: saving to the hidden folder for now. Tap to allow</string>
